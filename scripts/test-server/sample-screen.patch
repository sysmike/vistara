 #include "shadow.h"
 #include "shadow_rfx_dirty.h"
 
+/* Vistara test server: display control. A client's request for another
+ * desktop size is reported and then carried out, so that tests can check both
+ * the request and the resize that follows it. */
+#include <stdio.h>
+#include <freerdp/server/disp.h>
+
+#define VISTARA_TEST_COLOR 0xFF336699u
+
+static volatile LONG vistara_resize_width = 0;
+static volatile LONG vistara_resize_height = 0;
+
+static UINT vistara_disp_layout(WINPR_ATTR_UNUSED DispServerContext* context,
+                                const DISPLAY_CONTROL_MONITOR_LAYOUT_PDU* pdu)
+{
+	if (!pdu || (pdu->NumMonitors < 1) || !pdu->Monitors)
+		return CHANNEL_RC_OK;
+	const DISPLAY_CONTROL_MONITOR_LAYOUT* monitor = &pdu->Monitors[0];
+	(void)fprintf(stderr, "vistara-input layout width=0x%04x height=0x%04x scale=0x%04x\n",
+	              (unsigned)monitor->Width, (unsigned)monitor->Height,
+	              (unsigned)monitor->DesktopScaleFactor);
+	/* Several monitors: each one, and the screen becomes their bounding box. */
+	INT64 left = 0, top = 0, right = monitor->Width, bottom = monitor->Height;
+	for (UINT32 index = 0; (pdu->NumMonitors > 1) && (index < pdu->NumMonitors); index++)
+	{
+		const DISPLAY_CONTROL_MONITOR_LAYOUT* each = &pdu->Monitors[index];
+		(void)fprintf(stderr,
+		              "vistara-monitor via=display-control index=%u left=%d top=%d width=%u height=%u "
+		              "primary=%u scale=%u\n",
+		              (unsigned)index, (int)each->Left, (int)each->Top, (unsigned)each->Width,
+		              (unsigned)each->Height,
+		              (each->Flags & DISPLAY_CONTROL_MONITOR_PRIMARY) ? 1u : 0u,
+		              (unsigned)each->DesktopScaleFactor);
+		if ((INT64)each->Left < left)
+			left = each->Left;
+		if ((INT64)each->Top < top)
+			top = each->Top;
+		if ((INT64)each->Left + each->Width > right)
+			right = (INT64)each->Left + each->Width;
+		if ((INT64)each->Top + each->Height > bottom)
+			bottom = (INT64)each->Top + each->Height;
+	}
+	(void)fflush(stderr);
+	(void)InterlockedExchange(&vistara_resize_width, (LONG)(right - left));
+	(void)InterlockedExchange(&vistara_resize_height, (LONG)(bottom - top));
+	return CHANNEL_RC_OK;
+}
+
+/* One client's display control channel. Lives on that client's thread. */
+typedef struct
+{
+	DispServerContext* disp;
+	UINT32 channelId;
+	BOOL tried;
+	BOOL created;
+	BOOL capsSent;
+} vistaraDisp;
+
+static BOOL vistara_disp_channel_id(DispServerContext* context, UINT32 channelId)
+{
+	vistaraDisp* state = context->custom;
+	state->channelId = channelId;
+	return TRUE;
+}
+
+/* The client has answered the request to create a dynamic channel. */
+static BOOL vistara_dvc_created(void* userdata, UINT32 channelId, INT32 creationStatus)
+{
+	vistaraDisp* state = userdata;
+	if (state->disp && (channelId == state->channelId) && (creationStatus >= 0))
+		state->created = TRUE;
+	return TRUE;
+}
+
+static void vistara_disp_open(rdpShadowClient* client, vistaraDisp* state)
+{
+	state->tried = TRUE;
+	DispServerContext* disp = disp_server_context_new(client->vcm);
+	if (!disp)
+		return;
+	disp->custom = state;
+	/* As many monitors as RDP allows, for multi-monitor layouts. */
+	disp->MaxNumMonitors = 16;
+	disp->MaxMonitorAreaFactorA = 8192;
+	disp->MaxMonitorAreaFactorB = 8192;
+	disp->DispMonitorLayout = vistara_disp_layout;
+	disp->ChannelIdAssigned = vistara_disp_channel_id;
+	state->disp = disp;
+	WTSVirtualChannelManagerSetDVCCreationCallback(client->vcm, vistara_dvc_created, state);
+	if (disp->Open(disp) != CHANNEL_RC_OK)
+	{
+		state->disp = nullptr;
+		disp_server_context_free(disp);
+	}
+}
+
+/* Display control has no negotiation: the server states its limits as soon
+ * as the client has the channel, and the client may then ask for a size. */
+static void vistara_disp_send_caps(vistaraDisp* state)
+{
+	if (!state->disp || !state->created || state->capsSent)
+		return;
+	state->capsSent = TRUE;
+	const UINT rc = state->disp->DisplayControlCaps(state->disp);
+	(void)fprintf(stderr, "vistara-disp caps sent rc=%u\n", (unsigned)rc);
+	(void)fflush(stderr);
+}
+
+/* Vistara test server: a clipboard. It offers a known text and a few files as
+ * soon as the client's clipboard is up, and reports the text a client offers
+ * it, in hex, so tests can check both directions. Files a client offers are
+ * listed and fetched under a lock, slowly, each file's bytes reported as a
+ * checksum; what the client copies meanwhile is not fetched. When a client
+ * offers a file whose name holds vistara_copy_during_fetch, the server copies
+ * a new text in the middle of that client's next locked fetch of the report. */
+#include <freerdp/server/cliprdr.h>
+#include <freerdp/utils/cliprdr_utils.h>
+#include <winpr/file.h>
+#include <winpr/shell.h>
+#include <winpr/string.h>
+#include <winpr/user.h>
+
+/* Logs "<prefix><bytes in hex>" as one line with one write, so that lines
+ * from other threads cannot land inside it. */
+static void vistara_log_hex(const char* prefix, const BYTE* bytes, size_t length)
+{
+	const size_t prefixLength = strlen(prefix);
+	char* line = calloc(prefixLength + 2 * length + 2, 1);
+	if (!line)
+		return;
+	memcpy(line, prefix, prefixLength);
+	for (size_t i = 0; i < length; i++)
+		(void)sprintf(&line[prefixLength + 2 * i], "%02x", (unsigned)bytes[i]);
+	line[prefixLength + 2 * length] = '\n';
+	(void)fputs(line, stderr);
+	(void)fflush(stderr);
+	free(line);
+}
+
+static const char vistara_copy_during_fetch[] = "copy something else while I fetch";
+static const char vistara_clipboard_new_text[] = "Neuer Text aus dem Testserver";
+static const char vistara_clipboard_text[] = "Gr\xc3\xbc\xc3\x9f" "e aus dem Testserver \xe2\x9c\x93\r\nZweite Zeile";
+
+/* The files the server offers. The report's bytes follow vistara_report_byte()
+ * and it spans several of the client's parts; the last file's size is left
+ * out of the list, so a client has to ask for it. */
+#define VISTARA_FORMAT_FILE_LIST 0xC0A0u
+#define VISTARA_FORMAT_FILE_CONTENTS 0xC0A1u
+#define VISTARA_REPORT_SIZE (2621440ull + 123ull)
+
+typedef struct
+{
+	const char* name;
+	BOOL folder;
+	BOOL listsSize;
+	const char* text;
+} vistaraServerFile;
+
+static const vistaraServerFile vistara_server_files[] = {
+	{ "Server Report.bin", FALSE, TRUE, nullptr },
+	{ "Server Folder", TRUE, TRUE, nullptr },
+	{ "Server Folder\\Gr\xc3\xbc\xc3\x9f" "e \xe2\x9c\x93.txt", FALSE, TRUE, "Inhalt aus dem Testserver\r\n" },
+	{ "Server Folder\\Q1/Q2.txt", FALSE, FALSE, "Ohne Gr\xc3\xb6\xc3\x9f" "e\r\n" },
+	{ "\\Absolute.txt", FALSE, TRUE, "Never written\r\n" },
+};
+
+static BYTE vistara_report_byte(UINT64 offset)
+{
+	return (BYTE)((offset * 31u + (offset >> 16)) & 0xFFu);
+}
+
+static UINT64 vistara_server_file_size(const vistaraServerFile* file)
+{
+	if (file->folder)
+		return 0;
+	return file->text ? strlen(file->text) : VISTARA_REPORT_SIZE;
+}
+
+/* What the server is fetching from the client: its list, and one file at a
+ * time, in parts of VISTARA_CLIENT_PART. Then two requests the client must
+ * refuse: a folder's contents and an index beyond the list. */
+#define VISTARA_CLIENT_PART (1024u * 1024u)
+
+typedef enum
+{
+	VISTARA_FETCH_FILES,
+	VISTARA_FETCH_FOLDER,
+	VISTARA_FETCH_BEYOND,
+	VISTARA_FETCH_NONE
+} vistaraFetchStep;
+
+typedef struct
+{
+	CliprdrServerContext* cliprdr;
+	BOOL tried;
+	BOOL awaitingFiles;
+	FILEDESCRIPTORW* clientFiles;
+	UINT32 clientCount;
+	vistaraFetchStep step;
+	UINT32 index;
+	UINT64 offset;
+	UINT64 checksum;
+	UINT32 streamId;
+	/* The lock the server holds while fetching the client's files. */
+	UINT32 lockId;
+	/* The client asked the server to copy something else during its next
+	 * locked fetch of the report, and whether it did. */
+	BOOL copyDuringFetch;
+	BOOL copied;
+} vistaraClipboard;
+
+static UINT vistara_clip_client_caps(CliprdrServerContext* context,
+                                     WINPR_ATTR_UNUSED const CLIPRDR_CAPABILITIES* capabilities)
+{
+	(void)fprintf(stderr, "vistara-clipboard joined files=%u\n",
+	              (unsigned)context->streamFileClipEnabled);
+	(void)fflush(stderr);
+	CLIPRDR_FORMAT formats[] = {
+		{ .formatId = CF_UNICODETEXT, .formatName = nullptr },
+		{ .formatId = VISTARA_FORMAT_FILE_LIST, .formatName = "FileGroupDescriptorW" },
+		{ .formatId = VISTARA_FORMAT_FILE_CONTENTS, .formatName = "FileContents" },
+	};
+	CLIPRDR_FORMAT_LIST list = WINPR_C_ARRAY_INIT;
+	list.common.msgType = CB_FORMAT_LIST;
+	list.numFormats = ARRAYSIZE(formats);
+	list.formats = formats;
+	return context->ServerFormatList(context, &list);
+}
+
+static UINT vistara_clip_request(CliprdrServerContext* context, vistaraClipboard* state,
+                                 UINT32 index, UINT32 flags, UINT64 offset, UINT32 length)
+{
+	CLIPRDR_FILE_CONTENTS_REQUEST request = WINPR_C_ARRAY_INIT;
+	request.common.msgType = CB_FILECONTENTS_REQUEST;
+	request.streamId = ++state->streamId;
+	request.listIndex = index;
+	request.dwFlags = flags;
+	request.nPositionLow = (UINT32)(offset & 0xFFFFFFFFu);
+	request.nPositionHigh = (UINT32)(offset >> 32);
+	request.cbRequested = length;
+	request.haveClipDataId = state->lockId != 0;
+	request.clipDataId = state->lockId;
+	return context->ServerFileContentsRequest(context, &request);
+}
+
+static UINT64 vistara_client_file_size(const FILEDESCRIPTORW* file)
+{
+	return ((UINT64)file->nFileSizeHigh << 32) | file->nFileSizeLow;
+}
+
+static BOOL vistara_client_file_is_folder(const FILEDESCRIPTORW* file)
+{
+	return (file->dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0;
+}
+
+/* Asks for the next part of what the server is fetching, logging each file
+ * as it is complete. */
+static UINT vistara_clip_fetch_next(CliprdrServerContext* context, vistaraClipboard* state)
+{
+	while (state->step == VISTARA_FETCH_FILES && state->index < state->clientCount)
+	{
+		const FILEDESCRIPTORW* file = &state->clientFiles[state->index];
+		const UINT64 size = vistara_client_file_size(file);
+		if (!vistara_client_file_is_folder(file) && state->offset < size)
+		{
+			const UINT64 left = size - state->offset;
+			return vistara_clip_request(context, state, state->index, FILECONTENTS_RANGE,
+			                            state->offset,
+			                            left < VISTARA_CLIENT_PART ? (UINT32)left : VISTARA_CLIENT_PART);
+		}
+		if (!vistara_client_file_is_folder(file))
+		{
+			(void)fprintf(stderr, "vistara-clipboard client-file-done index=%u bytes=%llu fnv=%016llx\n",
+			              (unsigned)state->index, (unsigned long long)state->offset,
+			              (unsigned long long)state->checksum);
+			(void)fflush(stderr);
+		}
+		state->index++;
+		state->offset = 0;
+		state->checksum = 0xcbf29ce484222325ull;
+	}
+	if (state->step == VISTARA_FETCH_FILES)
+	{
+		state->step = VISTARA_FETCH_FOLDER;
+		for (UINT32 index = 0; index < state->clientCount; index++)
+		{
+			if (vistara_client_file_is_folder(&state->clientFiles[index]))
+				return vistara_clip_request(context, state, index, FILECONTENTS_RANGE, 0, 16);
+		}
+	}
+	if (state->step == VISTARA_FETCH_FOLDER)
+	{
+		state->step = VISTARA_FETCH_BEYOND;
+		return vistara_clip_request(context, state, state->clientCount, FILECONTENTS_RANGE, 0, 16);
+	}
+	state->step = VISTARA_FETCH_NONE;
+	if (state->lockId != 0)
+	{
+		CLIPRDR_UNLOCK_CLIPBOARD_DATA unlock = WINPR_C_ARRAY_INIT;
+		unlock.common.msgType = CB_UNLOCK_CLIPDATA;
+		unlock.clipDataId = state->lockId;
+		(void)context->ServerUnlockClipboardData(context, &unlock);
+		state->lockId = 0;
+	}
+	(void)fprintf(stderr, "vistara-clipboard client-files-done\n");
+	(void)fflush(stderr);
+	return CHANNEL_RC_OK;
+}
+
+static UINT vistara_clip_client_contents_response(CliprdrServerContext* context,
+                                                  const CLIPRDR_FILE_CONTENTS_RESPONSE* response)
+{
+	vistaraClipboard* state = context->custom;
+	if (response->streamId != state->streamId || state->step == VISTARA_FETCH_NONE)
+		return CHANNEL_RC_OK;
+	const BOOL ok = (response->common.msgFlags & CB_RESPONSE_OK) != 0;
+	if (state->step != VISTARA_FETCH_FILES)
+	{
+		(void)fprintf(stderr, "vistara-clipboard client-refused what=%s ok=%u\n",
+		              state->step == VISTARA_FETCH_FOLDER ? "folder" : "beyond", (unsigned)ok);
+		(void)fflush(stderr);
+		return vistara_clip_fetch_next(context, state);
+	}
+	if (!ok || (response->cbRequested == 0))
+	{
+		(void)fprintf(stderr, "vistara-clipboard client-file-failed index=%u\n", (unsigned)state->index);
+		(void)fflush(stderr);
+		state->index++;
+		state->offset = 0;
+		state->checksum = 0xcbf29ce484222325ull;
+		return vistara_clip_fetch_next(context, state);
+	}
+	for (UINT32 i = 0; i < response->cbRequested; i++)
+	{
+		state->checksum ^= response->requestedData[i];
+		state->checksum *= 0x100000001b3ull;
+	}
+	state->offset += response->cbRequested;
+	(void)fprintf(stderr, "vistara-clipboard client-part index=%u offset=%llu\n", (unsigned)state->index,
+	              (unsigned long long)state->offset);
+	(void)fflush(stderr);
+	/* Slow enough that a client can copy something else in the middle. */
+	Sleep(150);
+	return vistara_clip_fetch_next(context, state);
+}
+
+/* The client asks for a part of a file the server offers. */
+static UINT vistara_clip_client_contents_request(CliprdrServerContext* context,
+                                                 const CLIPRDR_FILE_CONTENTS_REQUEST* request)
+{
+	vistaraClipboard* state = context->custom;
+	const UINT64 offset = ((UINT64)request->nPositionHigh << 32) | request->nPositionLow;
+	char lock[16] = "none";
+	if (request->haveClipDataId)
+		(void)snprintf(lock, sizeof(lock), "%u", (unsigned)request->clipDataId);
+	(void)fprintf(stderr,
+	              "vistara-clipboard file-request index=%u flags=%u offset=%llu requested=%u lock=%s\n",
+	              (unsigned)request->listIndex, (unsigned)request->dwFlags,
+	              (unsigned long long)offset, (unsigned)request->cbRequested, lock);
+	(void)fflush(stderr);
+	/* Someone copies something else on the remote computer while the client
+	 * fetches the report, which the client's lock keeps. */
+	if (state->copyDuringFetch && !state->copied && request->haveClipDataId &&
+	    (request->listIndex == 0) && (offset >= VISTARA_CLIENT_PART))
+	{
+		state->copied = TRUE;
+		CLIPRDR_FORMAT format = { .formatId = CF_UNICODETEXT, .formatName = nullptr };
+		CLIPRDR_FORMAT_LIST list = WINPR_C_ARRAY_INIT;
+		list.common.msgType = CB_FORMAT_LIST;
+		list.numFormats = 1;
+		list.formats = &format;
+		(void)context->ServerFormatList(context, &list);
+		(void)fprintf(stderr, "vistara-clipboard copied-during-fetch\n");
+		(void)fflush(stderr);
+	}
+	CLIPRDR_FILE_CONTENTS_RESPONSE response = WINPR_C_ARRAY_INIT;
+	response.common.msgType = CB_FILECONTENTS_RESPONSE;
+	response.common.msgFlags = CB_RESPONSE_FAIL;
+	response.streamId = request->streamId;
+	BYTE* data = nullptr;
+	BYTE size[8] = WINPR_C_ARRAY_INIT;
+	const vistaraServerFile* file = (request->listIndex < ARRAYSIZE(vistara_server_files))
+	                                    ? &vistara_server_files[request->listIndex]
+	                                    : nullptr;
+	if (file && !file->folder && (request->dwFlags & FILECONTENTS_SIZE))
+	{
+		const UINT64 value = vistara_server_file_size(file);
+		for (size_t i = 0; i < sizeof(size); i++)
+			size[i] = (BYTE)(value >> (8 * i));
+		response.common.msgFlags = CB_RESPONSE_OK;
+		response.cbRequested = sizeof(size);
+		response.requestedData = size;
+	}
+	else if (file && !file->folder && (request->dwFlags & FILECONTENTS_RANGE))
+	{
+		const UINT64 total = vistara_server_file_size(file);
+		const UINT64 left = offset < total ? total - offset : 0;
+		const UINT32 length = left < request->cbRequested ? (UINT32)left : request->cbRequested;
+		data = malloc(length ? length : 1);
+		if (data)
+		{
+			for (UINT32 i = 0; i < length; i++)
+				data[i] = file->text ? (BYTE)file->text[offset + i] : vistara_report_byte(offset + i);
+			response.common.msgFlags = CB_RESPONSE_OK;
+			response.cbRequested = length;
+			response.requestedData = data;
+		}
+		/* Slow enough that a client can cancel in the middle of the report. */
+		if (!file->text)
+			Sleep(100);
+	}
+	const UINT rc = context->ServerFileContentsResponse(context, &response);
+	free(data);
+	return rc;
+}
+
+static UINT vistara_clip_send_file_list(CliprdrServerContext* context)
+{
+	FILEDESCRIPTORW descriptors[ARRAYSIZE(vistara_server_files)] = WINPR_C_ARRAY_INIT;
+	for (size_t i = 0; i < ARRAYSIZE(vistara_server_files); i++)
+	{
+		const vistaraServerFile* file = &vistara_server_files[i];
+		FILEDESCRIPTORW* descriptor = &descriptors[i];
+		descriptor->dwFlags = FD_ATTRIBUTES | (file->listsSize ? FD_FILESIZE : 0);
+		descriptor->dwFileAttributes = file->folder ? FILE_ATTRIBUTE_DIRECTORY : FILE_ATTRIBUTE_NORMAL;
+		const UINT64 size = file->listsSize ? vistara_server_file_size(file) : 0;
+		descriptor->nFileSizeHigh = (UINT32)(size >> 32);
+		descriptor->nFileSizeLow = (UINT32)(size & 0xFFFFFFFFu);
+		(void)ConvertUtf8ToWChar(file->name, descriptor->cFileName, ARRAYSIZE(descriptor->cFileName));
+	}
+	BYTE* data = nullptr;
+	UINT32 length = 0;
+	CLIPRDR_FORMAT_DATA_RESPONSE response = WINPR_C_ARRAY_INIT;
+	response.common.msgType = CB_FORMAT_DATA_RESPONSE;
+	response.common.msgFlags = CB_RESPONSE_FAIL;
+	if (cliprdr_serialize_file_list_ex(CB_STREAM_FILECLIP_ENABLED | CB_HUGE_FILE_SUPPORT_ENABLED,
+	                                   descriptors, ARRAYSIZE(descriptors), &data,
+	                                   &length) == CHANNEL_RC_OK)
+	{
+		response.common.msgFlags = CB_RESPONSE_OK;
+		response.common.dataLen = length;
+		response.requestedFormatData = data;
+	}
+	const UINT rc = context->ServerFormatDataResponse(context, &response);
+	free(data);
+	return rc;
+}
+
+static UINT vistara_clip_client_format_list(CliprdrServerContext* context,
+                                            const CLIPRDR_FORMAT_LIST* list)
+{
+	vistaraClipboard* state = context->custom;
+	CLIPRDR_FORMAT_LIST_RESPONSE response = WINPR_C_ARRAY_INIT;
+	response.common.msgType = CB_FORMAT_LIST_RESPONSE;
+	response.common.msgFlags = CB_RESPONSE_OK;
+	const UINT rc = context->ServerFormatListResponse(context, &response);
+	if (rc != CHANNEL_RC_OK)
+		return rc;
+	/* The client copied something else while the server fetches its files:
+	 * the fetch goes on with what it locked. */
+	if (state->step != VISTARA_FETCH_NONE)
+	{
+		(void)fprintf(stderr, "vistara-clipboard client-copied-during-fetch\n");
+		(void)fflush(stderr);
+		return CHANNEL_RC_OK;
+	}
+	UINT32 wanted = 0;
+	for (UINT32 i = 0; i < list->numFormats; i++)
+	{
+		const CLIPRDR_FORMAT* format = &list->formats[i];
+		if (format->formatName && (strcmp(format->formatName, "FileGroupDescriptorW") == 0))
+			wanted = format->formatId;
+		else if ((format->formatId == CF_UNICODETEXT) && (wanted == 0))
+			wanted = CF_UNICODETEXT;
+	}
+	if (wanted == 0)
+		return CHANNEL_RC_OK;
+	state->awaitingFiles = wanted != CF_UNICODETEXT;
+	CLIPRDR_FORMAT_DATA_REQUEST request = WINPR_C_ARRAY_INIT;
+	request.common.msgType = CB_FORMAT_DATA_REQUEST;
+	request.requestedFormatId = wanted;
+	return context->ServerFormatDataRequest(context, &request);
+}
+
+static UINT vistara_clip_client_format_list_response(
+    WINPR_ATTR_UNUSED CliprdrServerContext* context,
+    WINPR_ATTR_UNUSED const CLIPRDR_FORMAT_LIST_RESPONSE* response)
+{
+	return CHANNEL_RC_OK;
+}
+
+static UINT vistara_clip_client_data_request(CliprdrServerContext* context,
+                                             const CLIPRDR_FORMAT_DATA_REQUEST* request)
+{
+	const vistaraClipboard* state = context->custom;
+	if ((request->requestedFormatId == VISTARA_FORMAT_FILE_LIST) && !state->copied)
+		return vistara_clip_send_file_list(context);
+	CLIPRDR_FORMAT_DATA_RESPONSE response = WINPR_C_ARRAY_INIT;
+	response.common.msgType = CB_FORMAT_DATA_RESPONSE;
+	size_t length = 0;
+	WCHAR* text = ConvertUtf8ToWCharAlloc(state->copied ? vistara_clipboard_new_text : vistara_clipboard_text,
+	                                      &length);
+	if ((request->requestedFormatId == CF_UNICODETEXT) && text)
+	{
+		response.common.msgFlags = CB_RESPONSE_OK;
+		response.common.dataLen = (UINT32)((length + 1) * sizeof(WCHAR));
+		response.requestedFormatData = (const BYTE*)text;
+	}
+	else
+		response.common.msgFlags = CB_RESPONSE_FAIL;
+	const UINT rc = context->ServerFormatDataResponse(context, &response);
+	free(text);
+	return rc;
+}
+
+/* The client's file list: each entry is logged, then its files fetched. */
+static UINT vistara_clip_take_client_files(CliprdrServerContext* context, vistaraClipboard* state,
+                                           const CLIPRDR_FORMAT_DATA_RESPONSE* response)
+{
+	free(state->clientFiles);
+	state->clientFiles = nullptr;
+	state->clientCount = 0;
+	if (cliprdr_parse_file_list(response->requestedFormatData, response->common.dataLen,
+	                            &state->clientFiles, &state->clientCount) != CHANNEL_RC_OK)
+	{
+		(void)fprintf(stderr, "vistara-clipboard client-list unreadable\n");
+		(void)fflush(stderr);
+		return CHANNEL_RC_OK;
+	}
+	(void)fprintf(stderr, "vistara-clipboard client-list count=%u\n", (unsigned)state->clientCount);
+	for (UINT32 i = 0; i < state->clientCount; i++)
+	{
+		const FILEDESCRIPTORW* file = &state->clientFiles[i];
+		char* name = ConvertWCharNToUtf8Alloc(
+		    file->cFileName, _wcsnlen(file->cFileName, ARRAYSIZE(file->cFileName)), nullptr);
+		char prefix[128] = { 0 };
+		(void)snprintf(prefix, sizeof(prefix),
+		               "vistara-clipboard client-file index=%u folder=%u size=%llu name=", (unsigned)i,
+		               (unsigned)vistara_client_file_is_folder(file),
+		               (unsigned long long)vistara_client_file_size(file));
+		vistara_log_hex(prefix, (const BYTE*)(name ? name : ""), name ? strlen(name) : 0);
+		if (name && strstr(name, vistara_copy_during_fetch))
+			state->copyDuringFetch = TRUE;
+		free(name);
+	}
+	(void)fflush(stderr);
+	state->step = VISTARA_FETCH_FILES;
+	state->index = 0;
+	state->offset = 0;
+	state->checksum = 0xcbf29ce484222325ull;
+	if (context->canLockClipData)
+	{
+		CLIPRDR_LOCK_CLIPBOARD_DATA lock = WINPR_C_ARRAY_INIT;
+		lock.common.msgType = CB_LOCK_CLIPDATA;
+		lock.clipDataId = 7;
+		if (context->ServerLockClipboardData(context, &lock) == CHANNEL_RC_OK)
+			state->lockId = lock.clipDataId;
+	}
+	(void)fprintf(stderr, "vistara-clipboard client-lock=%u\n", (unsigned)state->lockId);
+	(void)fflush(stderr);
+	return vistara_clip_fetch_next(context, state);
+}
+
+static UINT vistara_clip_client_data_response(CliprdrServerContext* context,
+                                              const CLIPRDR_FORMAT_DATA_RESPONSE* response)
+{
+	vistaraClipboard* state = context->custom;
+	const BOOL files = state->awaitingFiles;
+	state->awaitingFiles = FALSE;
+	if (!(response->common.msgFlags & CB_RESPONSE_OK) || !response->requestedFormatData)
+		return CHANNEL_RC_OK;
+	if (files)
+		return vistara_clip_take_client_files(context, state, response);
+	vistara_log_hex("vistara-clipboard from-client ", response->requestedFormatData,
+	                response->common.dataLen);
+	return CHANNEL_RC_OK;
+}
+
+static UINT vistara_clip_client_lock(WINPR_ATTR_UNUSED CliprdrServerContext* context,
+                                     const CLIPRDR_LOCK_CLIPBOARD_DATA* lock)
+{
+	(void)fprintf(stderr, "vistara-clipboard locked id=%u\n", (unsigned)lock->clipDataId);
+	(void)fflush(stderr);
+	return CHANNEL_RC_OK;
+}
+
+static UINT vistara_clip_client_unlock(WINPR_ATTR_UNUSED CliprdrServerContext* context,
+                                       const CLIPRDR_UNLOCK_CLIPBOARD_DATA* unlock)
+{
+	(void)fprintf(stderr, "vistara-clipboard unlocked id=%u\n", (unsigned)unlock->clipDataId);
+	(void)fflush(stderr);
+	return CHANNEL_RC_OK;
+}
+
+static void vistara_clipboard_open(rdpShadowClient* client, vistaraClipboard* state)
+{
+	if (state->tried || !client->activated ||
+	    !WTSVirtualChannelManagerIsChannelJoined(client->vcm, CLIPRDR_SVC_CHANNEL_NAME))
+		return;
+	state->tried = TRUE;
+	state->step = VISTARA_FETCH_NONE;
+	CliprdrServerContext* cliprdr = cliprdr_server_context_new(client->vcm);
+	if (!cliprdr)
+		return;
+	cliprdr->rdpcontext = &client->context;
+	cliprdr->custom = state;
+	cliprdr->useLongFormatNames = TRUE;
+	cliprdr->streamFileClipEnabled = TRUE;
+	cliprdr->fileClipNoFilePaths = TRUE;
+	cliprdr->hasHugeFileSupport = TRUE;
+	cliprdr->canLockClipData = TRUE;
+	cliprdr->ClientLockClipboardData = vistara_clip_client_lock;
+	cliprdr->ClientUnlockClipboardData = vistara_clip_client_unlock;
+	cliprdr->ClientCapabilities = vistara_clip_client_caps;
+	cliprdr->ClientFormatList = vistara_clip_client_format_list;
+	cliprdr->ClientFormatListResponse = vistara_clip_client_format_list_response;
+	cliprdr->ClientFormatDataRequest = vistara_clip_client_data_request;
+	cliprdr->ClientFormatDataResponse = vistara_clip_client_data_response;
+	cliprdr->ClientFileContentsRequest = vistara_clip_client_contents_request;
+	cliprdr->ClientFileContentsResponse = vistara_clip_client_contents_response;
+	if (cliprdr->Start(cliprdr) != CHANNEL_RC_OK)
+	{
+		cliprdr_server_context_free(cliprdr);
+		return;
+	}
+	state->cliprdr = cliprdr;
+}
+
+static void vistara_clipboard_close(vistaraClipboard* state)
+{
+	if (state->cliprdr)
+	{
+		(void)state->cliprdr->Stop(state->cliprdr);
+		cliprdr_server_context_free(state->cliprdr);
+		state->cliprdr = nullptr;
+	}
+	free(state->clientFiles);
+	state->clientFiles = nullptr;
+}
+
+/* Vistara test server: shared folders. For every drive a client announces,
+ * the server lists its top folder, reads hello.txt, tries to leave the folder
+ * through ".." (and reads what it got, if the client said yes), and writes
+ * from-server.txt, reporting each result. Tests
+ * check that only the shared folders arrive and what each operation did. */
+#include <freerdp/server/rdpdr.h>
+
+#define VISTARA_FILE_READ_DATA 0x00000001u
+#define VISTARA_FILE_WRITE_DATA 0x00000002u
+#define VISTARA_FILE_OPEN 0x00000001u
+#define VISTARA_FILE_OVERWRITE_IF 0x00000005u
+
+static const char vistara_drive_text[] = "written by the test server";
+
+typedef enum
+{
+	VISTARA_DRIVE_LIST,
+	VISTARA_DRIVE_READ_OPEN,
+	VISTARA_DRIVE_READ,
+	VISTARA_DRIVE_READ_CLOSE,
+	VISTARA_DRIVE_ESCAPE_OPEN,
+	VISTARA_DRIVE_ESCAPE_READ,
+	VISTARA_DRIVE_ESCAPE_CLOSE,
+	VISTARA_DRIVE_WRITE_OPEN,
+	VISTARA_DRIVE_WRITE,
+	VISTARA_DRIVE_WRITE_CLOSE
+} vistaraDriveStep;
+
+/* One drive's way through the steps above. */
+typedef struct
+{
+	UINT32 deviceId;
+	UINT32 fileId;
+	char name[9];
+	vistaraDriveStep step;
+} vistaraDriveRun;
+
+typedef struct
+{
+	RdpdrServerContext* rdpdr;
+	BOOL tried;
+} vistaraDrives;
+
+static void vistara_drive_report(const vistaraDriveRun* run, const char* event, UINT32 status)
+{
+	(void)fprintf(stderr, "vistara-drive %s name=%s status=0x%08x\n", event, run->name,
+	              (unsigned)status);
+	(void)fflush(stderr);
+}
+
+static void vistara_drive_done(vistaraDriveRun* run)
+{
+	(void)fprintf(stderr, "vistara-drive done name=%s\n", run->name);
+	(void)fflush(stderr);
+	free(run);
+}
+
+static void vistara_drive_write_open(RdpdrServerContext* context, vistaraDriveRun* run)
+{
+	run->step = VISTARA_DRIVE_WRITE_OPEN;
+	if (context->DriveOpenFile(context, run, run->deviceId, "\\from-server.txt",
+	                           VISTARA_FILE_WRITE_DATA, VISTARA_FILE_OVERWRITE_IF) != CHANNEL_RC_OK)
+		vistara_drive_done(run);
+}
+
+static void vistara_drive_escape_open(RdpdrServerContext* context, vistaraDriveRun* run)
+{
+	run->step = VISTARA_DRIVE_ESCAPE_OPEN;
+	if (context->DriveOpenFile(context, run, run->deviceId, "\\..\\outside.txt",
+	                           VISTARA_FILE_READ_DATA, VISTARA_FILE_OPEN) != CHANNEL_RC_OK)
+		vistara_drive_done(run);
+}
+
+static void vistara_drive_close(RdpdrServerContext* context, vistaraDriveRun* run,
+                                vistaraDriveStep step)
+{
+	run->step = step;
+	if (context->DriveCloseFile(context, run, run->deviceId, run->fileId) != CHANNEL_RC_OK)
+		vistara_drive_done(run);
+}
+
+static UINT vistara_drive_created(RdpdrServerContext* context, const RdpdrDevice* device)
+{
+	vistaraDriveRun* run = calloc(1, sizeof(vistaraDriveRun));
+	if (!run)
+		return CHANNEL_RC_NO_MEMORY;
+	run->deviceId = device->DeviceId;
+	memcpy(run->name, device->PreferredDosName, sizeof(device->PreferredDosName));
+	(void)fprintf(stderr, "vistara-drive announced name=%s\n", run->name);
+	(void)fflush(stderr);
+	run->step = VISTARA_DRIVE_LIST;
+	if (context->DriveQueryDirectory(context, run, run->deviceId, "") != CHANNEL_RC_OK)
+		vistara_drive_done(run);
+	return CHANNEL_RC_OK;
+}
+
+static void vistara_drive_listed(RdpdrServerContext* context, void* data, UINT32 status,
+                                 FILE_DIRECTORY_INFORMATION* fdi)
+{
+	vistaraDriveRun* run = data;
+	if (status == STATUS_SUCCESS)
+	{
+		if (fdi)
+		{
+			(void)fprintf(stderr, "vistara-drive list name=%s file=%s\n", run->name, fdi->FileName);
+			(void)fflush(stderr);
+		}
+		return;
+	}
+	/* The end of the listing, or its failure. */
+	vistara_drive_report(run, "list-end", status);
+	run->step = VISTARA_DRIVE_READ_OPEN;
+	if (context->DriveOpenFile(context, run, run->deviceId, "\\hello.txt", VISTARA_FILE_READ_DATA,
+	                           VISTARA_FILE_OPEN) != CHANNEL_RC_OK)
+		vistara_drive_done(run);
+}
+
+static void vistara_drive_opened(RdpdrServerContext* context, void* data, UINT32 status,
+                                 WINPR_ATTR_UNUSED UINT32 deviceId, UINT32 fileId)
+{
+	vistaraDriveRun* run = data;
+	run->fileId = fileId;
+	switch (run->step)
+	{
+		case VISTARA_DRIVE_READ_OPEN:
+			if (status != STATUS_SUCCESS)
+			{
+				vistara_drive_report(run, "read", status);
+				vistara_drive_escape_open(context, run);
+				return;
+			}
+			run->step = VISTARA_DRIVE_READ;
+			if (context->DriveReadFile(context, run, run->deviceId, fileId, 4096, 0) !=
+			    CHANNEL_RC_OK)
+				vistara_drive_done(run);
+			return;
+		case VISTARA_DRIVE_ESCAPE_OPEN:
+			vistara_drive_report(run, "escape", status);
+			if (status != STATUS_SUCCESS)
+			{
+				vistara_drive_write_open(context, run);
+				return;
+			}
+			run->step = VISTARA_DRIVE_ESCAPE_READ;
+			if (context->DriveReadFile(context, run, run->deviceId, fileId, 4096, 0) !=
+			    CHANNEL_RC_OK)
+				vistara_drive_done(run);
+			return;
+		case VISTARA_DRIVE_WRITE_OPEN:
+			if (status != STATUS_SUCCESS)
+			{
+				vistara_drive_report(run, "write", status);
+				vistara_drive_done(run);
+				return;
+			}
+			run->step = VISTARA_DRIVE_WRITE;
+			if (context->DriveWriteFile(context, run, run->deviceId, fileId, vistara_drive_text,
+			                            sizeof(vistara_drive_text) - 1, 0) != CHANNEL_RC_OK)
+				vistara_drive_done(run);
+			return;
+		default:
+			vistara_drive_done(run);
+			return;
+	}
+}
+
+static void vistara_drive_read(RdpdrServerContext* context, void* data, UINT32 status,
+                               const char* buffer, UINT32 length)
+{
+	vistaraDriveRun* run = data;
+	const BOOL escaped = run->step == VISTARA_DRIVE_ESCAPE_READ;
+	char prefix[96] = { 0 };
+	(void)snprintf(prefix, sizeof(prefix), "vistara-drive %s name=%s status=0x%08x data=",
+	               escaped ? "escape-read" : "read", run->name, (unsigned)status);
+	vistara_log_hex(prefix, (const BYTE*)buffer, buffer ? length : 0);
+	vistara_drive_close(context, run, escaped ? VISTARA_DRIVE_ESCAPE_CLOSE : VISTARA_DRIVE_READ_CLOSE);
+}
+
+static void vistara_drive_written(RdpdrServerContext* context, void* data, UINT32 status,
+                                  WINPR_ATTR_UNUSED UINT32 bytesWritten)
+{
+	vistaraDriveRun* run = data;
+	vistara_drive_report(run, "write", status);
+	vistara_drive_close(context, run, VISTARA_DRIVE_WRITE_CLOSE);
+}
+
+static void vistara_drive_closed(RdpdrServerContext* context, void* data,
+                                 WINPR_ATTR_UNUSED UINT32 status)
+{
+	vistaraDriveRun* run = data;
+	switch (run->step)
+	{
+		case VISTARA_DRIVE_READ_CLOSE:
+			vistara_drive_escape_open(context, run);
+			return;
+		case VISTARA_DRIVE_ESCAPE_CLOSE:
+			vistara_drive_write_open(context, run);
+			return;
+		default:
+			vistara_drive_done(run);
+			return;
+	}
+}
+
+static void vistara_drives_open(rdpShadowClient* client, vistaraDrives* state)
+{
+	if (state->tried || !client->activated ||
+	    !WTSVirtualChannelManagerIsChannelJoined(client->vcm, RDPDR_SVC_CHANNEL_NAME))
+		return;
+	state->tried = TRUE;
+	RdpdrServerContext* rdpdr = rdpdr_server_context_new(client->vcm);
+	if (!rdpdr)
+		return;
+	rdpdr->rdpcontext = &client->context;
+	rdpdr->supported = RDPDR_DTYP_FILESYSTEM;
+	rdpdr->OnDriveCreate = vistara_drive_created;
+	rdpdr->OnDriveQueryDirectoryComplete = vistara_drive_listed;
+	rdpdr->OnDriveOpenFileComplete = vistara_drive_opened;
+	rdpdr->OnDriveReadFileComplete = vistara_drive_read;
+	rdpdr->OnDriveWriteFileComplete = vistara_drive_written;
+	rdpdr->OnDriveCloseFileComplete = vistara_drive_closed;
+	if (rdpdr->Start(rdpdr) != CHANNEL_RC_OK)
+	{
+		rdpdr_server_context_free(rdpdr);
+		return;
+	}
+	state->rdpdr = rdpdr;
+}
+
+static void vistara_drives_close(vistaraDrives* state)
+{
+	if (!state->rdpdr)
+		return;
+	(void)state->rdpdr->Stop(state->rdpdr);
+	rdpdr_server_context_free(state->rdpdr);
+	state->rdpdr = nullptr;
+}
+
+/* Runs on the client's own thread, which also sends its updates. */
+static void vistara_apply_resize(rdpShadowClient* client)
+{
+	const LONG width = InterlockedExchange(&vistara_resize_width, 0);
+	const LONG height = InterlockedExchange(&vistara_resize_height, 0);
+	if ((width < 200) || (height < 200) || (width > 8192) || (height > 8192))
+		return;
+
+	rdpShadowServer* server = client->server;
+	rdpShadowSubsystem* subsystem = server->subsystem;
+	MONITOR_DEF* monitor = &subsystem->monitors[subsystem->selectedMonitor];
+	monitor->right = monitor->left + width - 1;
+	monitor->bottom = monitor->top + height - 1;
+	if (!shadow_screen_resize(server->screen))
+		return;
+
+	rdpShadowSurface* surface = server->surface;
+	EnterCriticalSection(&surface->lock);
+	for (UINT32 y = 0; y < surface->height; y++)
+	{
+		UINT32* row = (UINT32*)(void*)&surface->data[1ull * y * surface->scanline];
+		for (UINT32 x = 0; x < surface->width; x++)
+			row[x] = VISTARA_TEST_COLOR;
+	}
+	LeaveCriticalSection(&surface->lock);
+}
