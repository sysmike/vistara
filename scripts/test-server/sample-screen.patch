 #define TAG SERVER_TAG("shadow.sample")
 
+/* Vistara test server: a solid-colour screen (blue 0x99, green 0x66, red 0x33)
+ * and a timer that tells clients to pick up pending updates. */
+#define VISTARA_TEST_COLOR 0xFF336699u
+
+static HANDLE vistara_stop_event = nullptr;
+static HANDLE vistara_tick_thread = nullptr;
+
+static void vistara_fill(rdpShadowSurface* surface)
+{
+	if (!surface || !surface->data)
+		return;
+	EnterCriticalSection(&surface->lock);
+	for (UINT32 y = 0; y < surface->height; y++)
+	{
+		UINT32* row = (UINT32*)(void*)&surface->data[1ull * y * surface->scanline];
+		for (UINT32 x = 0; x < surface->width; x++)
+			row[x] = VISTARA_TEST_COLOR;
+	}
+	LeaveCriticalSection(&surface->lock);
+}
+
+/* A 16x8 cursor with its hot spot at (3, 5): one colour (blue 0x50, green
+ * 0xC0, red 0x10), except for a transparent pixel in the top left corner. */
+#define VISTARA_CURSOR_WIDTH 16u
+#define VISTARA_CURSOR_HEIGHT 8u
+#define VISTARA_CURSOR_COLOR 0xFF10C050u
+
+static void vistara_message_free(WINPR_ATTR_UNUSED UINT32 id, SHADOW_MSG_OUT* msg)
+{
+	SHADOW_MSG_OUT_POINTER_ALPHA_UPDATE* update = (SHADOW_MSG_OUT_POINTER_ALPHA_UPDATE*)msg;
+	free(update->xorMaskData);
+	free(update->andMaskData);
+	free(update);
+}
+
+static void vistara_send_cursor(rdpShadowSubsystem* subsystem)
+{
+	UINT32 pixels[VISTARA_CURSOR_WIDTH * VISTARA_CURSOR_HEIGHT];
+	for (size_t i = 0; i < ARRAYSIZE(pixels); i++)
+		pixels[i] = VISTARA_CURSOR_COLOR;
+	pixels[0] = 0;
+
+	SHADOW_MSG_OUT_POINTER_ALPHA_UPDATE* msg = calloc(1, sizeof(SHADOW_MSG_OUT_POINTER_ALPHA_UPDATE));
+	if (!msg)
+		return;
+	msg->xHot = 3;
+	msg->yHot = 5;
+	msg->width = VISTARA_CURSOR_WIDTH;
+	msg->height = VISTARA_CURSOR_HEIGHT;
+	if (shadow_subsystem_pointer_convert_alpha_pointer_data_to_format(
+	        (const BYTE*)pixels, PIXEL_FORMAT_BGRA32, FALSE, msg->width, msg->height, msg) < 0)
+	{
+		free(msg);
+		return;
+	}
+	msg->common.Free = vistara_message_free;
+	/* The server frees the message once no client holds it any more. */
+	(void)shadow_client_boardcast_msg(subsystem->server, nullptr,
+	                                  SHADOW_MSG_OUT_POINTER_ALPHA_UPDATE_ID, (SHADOW_MSG_OUT*)msg,
+	                                  nullptr);
+}
+
+static DWORD WINAPI vistara_tick(LPVOID arg)
+{
+	rdpShadowSubsystem* subsystem = (rdpShadowSubsystem*)arg;
+	unsigned ticks = 0;
+	while (WaitForSingleObject(vistara_stop_event, 100) == WAIT_TIMEOUT)
+	{
+		shadow_subsystem_frame_update(subsystem);
+		/* Twice a second, so a client that just connected gets the cursor. */
+		if (++ticks % 5 == 0)
+			vistara_send_cursor(subsystem);
+	}
+	return 0;
+}
+
