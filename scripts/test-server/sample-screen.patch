+/* Pressing F24 (scancode 0x76) cuts the client's connection without a word,
+ * as a network that goes away would, so tests can check reconnection. */
+#define VISTARA_DROP_SCANCODE 0x76
+
+/* The peer's own sockfd is -1 once its transport took the socket; the
+ * transport's event handles wrap it instead. */
+static void vistara_drop(freerdp_peer* peer)
+{
+	HANDLE events[32] = { 0 };
+	const DWORD count = peer->GetEventHandles(peer, events, ARRAYSIZE(events));
+	for (DWORD i = 0; i < count; i++)
+	{
+		const int fd = GetEventFileDescriptor(events[i]);
+		int type = 0;
+		socklen_t length = sizeof(type);
+		if ((fd >= 0) && (getsockopt(fd, SOL_SOCKET, SO_TYPE, &type, &length) == 0) &&
+		    (type == SOCK_STREAM))
+		{
+			(void)fprintf(stderr, "vistara-drop fd=%d\n", fd);
+			(void)fflush(stderr);
+			(void)shutdown(fd, SHUT_RDWR);
+		}
+	}
+}
